# EditorConfig: https://editorconfig.org
# Formatting that the CI format checks enforce (gofmt, dotnet format, prettier).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go: gofmt uses tabs.
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

[Makefile]
indent_style = tab

# C# / MSBuild
# Only whitespace basics are set here on purpose: `dotnet format --verify-no-changes`
# (CI) and EnforceCodeStyleInBuild read this file, so style/analyzer rules belong to
# the server owners, not to this root file.
[*.cs]
indent_size = 4
# EF Core generates migrations with a UTF-8 BOM; do not make `dotnet format` flag them.
charset = unset
# The server code deliberately keeps short object initializers / anonymous types on
# one line. Without these two options `dotnet format --verify-no-changes` reports 285
# WHITESPACE errors on the current tree (measured 2026-11-11); with them it is clean.
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false

[*.{csproj,props,targets,sln,slnx}]
indent_size = 2

[*.sln]
indent_style = tab
end_of_line = crlf

# Web
[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html}]
indent_size = 2

# Markdown: two trailing spaces are a hard line break.
[*.md]
trim_trailing_whitespace = false

# PowerShell reads LF fine; batch files need CRLF.
[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.{wxs,wxi,wxl}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.bicep]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# Signature test vectors are byte-exact: never reformat.
[agent/internal/protocol/testdata/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
