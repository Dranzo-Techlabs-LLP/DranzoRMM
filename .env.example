# ---------------------------------------------------------------------------
# DranzoRMM environment template
#
#   cp .env.example .env      # .env is git-ignored; never commit it
#
# Every value below is an OBVIOUSLY FAKE PLACEHOLDER. Replace all of them.
# The server reads configuration from environment variables using the ASP.NET
# Core convention: "Dranzo:Section:Key" becomes "Dranzo__Section__Key".
# Full reference: docs/RUNBOOK.md section 2.
#
# In production do NOT use a .env file: secrets come from Azure Key Vault
# references on the Container Apps (deploy/bicep) and the managed identity.
# ---------------------------------------------------------------------------

# ----- PostgreSQL (local container) -----
POSTGRES_USER=dranzo
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_password
POSTGRES_DB=dranzo
# Connection string used by the server.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=dranzo;Username=dranzo;Password=CHANGE_ME_local_postgres_password
# Used only by `dotnet test` (the fixture creates and drops throwaway databases on this server).
DRANZO_TEST_PG=Host=localhost;Username=postgres;Password=CHANGE_ME_local_postgres_password

# ----- Server listeners and public URLs -----
ASPNETCORE_ENVIRONMENT=Development
Dranzo__DashboardPort=8080
Dranzo__AgentPort=8443
# DNS names / IPs placed in the agent listener's TLS certificate (issued by the private CA).
Dranzo__AgentHostnames__0=localhost
Dranzo__AgentHostnames__1=127.0.0.1
Dranzo__AgentHostnames__2=server
# URL agents are told to connect to, and the dashboard URL used in links.
Dranzo__PublicAgentUrl=https://localhost:8443
Dranzo__PublicDashboardUrl=http://localhost:5173
# true ONLY when the dashboard listener is reachable solely through a trusted reverse proxy
# (see docs/RUNBOOK.md "Reverse proxy and forwarded headers").
Dranzo__TrustForwardedHeaders=false

# ----- Key store (private CA key, command-signing key) -----
# file     = development / single node: directory outside the repository, mode 0700.
# keyvault = production: Azure Key Vault via managed identity (set VaultUri).
Dranzo__KeyStore__Type=file
Dranzo__KeyStore__Directory=/var/lib/dranzo/keys
# Dranzo__KeyStore__VaultUri=https://kv-EXAMPLE-NOT-REAL.vault.azure.net/

# ----- First administrator (used once, when the database has no partner yet) -----
# Remove these three values after the first start. MFA enrolment is forced at first sign-in.
Dranzo__Bootstrap__PartnerName=Example IT Services
Dranzo__Bootstrap__AdminEmail=admin@example.invalid
Dranzo__Bootstrap__AdminPassword=CHANGE_ME_at_least_12_chars_not_a_real_password

# ----- Object storage: MinIO locally (S3 API), Azure Blob in production -----
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
# file | s3 | azure
Dranzo__Storage__Type=s3
Dranzo__Storage__Bucket=dranzo
Dranzo__Storage__S3ServiceUrl=http://minio:9000
Dranzo__Storage__S3AccessKey=CHANGE_ME_minio_user
Dranzo__Storage__S3SecretKey=CHANGE_ME_minio_password_min_8_chars
# Dranzo__Storage__Directory=/var/lib/dranzo/storage          # Type=file
# Dranzo__Storage__AzureAccountUri=https://stEXAMPLEnotreal.blob.core.windows.net   # Type=azure (managed identity)
# Dranzo__Storage__AzureConnectionString=                      # Type=azure (discouraged: prefer managed identity)

# ----- SMTP (alert and notification e-mail) -----
Dranzo__Smtp__Host=smtp.example.invalid
Dranzo__Smtp__Port=587
Dranzo__Smtp__Username=CHANGE_ME_smtp_user
Dranzo__Smtp__Password=CHANGE_ME_smtp_password
Dranzo__Smtp__From=dranzormm@example.invalid
Dranzo__Smtp__UseStartTls=true

# ----- MeshCentral (remote desktop, Phase 6) -----
MESHCENTRAL_HOSTNAME=mesh.example.invalid
Dranzo__Mesh__Url=https://mesh.example.invalid
# 160 hex characters printed by `meshcentral --logintokenkey`. Treat as a secret.
Dranzo__Mesh__LoginTokenKey=CHANGE_ME_160_hex_chars_from_meshcentral_logintokenkey
Dranzo__Mesh__User=admin
Dranzo__Mesh__Domain=
Dranzo__Mesh__MeshId=CHANGE_ME_mesh_device_group_id

# ----- Vulnerability feeds (Phase 5) -----
Dranzo__Feeds__Enabled=false
Dranzo__Feeds__KevUrl=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
Dranzo__Feeds__NvdUrl=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional; raises the NVD rate limit. Request one at https://nvd.nist.gov/developers/request-an-api-key
Dranzo__Feeds__NvdApiKey=
Dranzo__Feeds__SyncHours=24

# ----- Local test agent container -----
# A short-lived enrollment token created in the dashboard (Enrollment -> New token).
DRANZO_ENROLL_TOKEN=dz_enroll_CHANGE_ME_not_a_real_token
DRANZO_SERVER_URL=https://server:8443

# ----- docker compose (deploy/docker-compose.yml) -----
# The compose file reads these names (plus POSTGRES_PASSWORD, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD and
# DRANZO_ENROLL_TOKEN above) and maps them onto the server settings.
DRANZO_PARTNER_NAME=CHANGE_ME My IT Company
DRANZO_ADMIN_EMAIL=CHANGE_ME_admin@example.test
# 12+ characters. Used once to create the first administrator; MFA enrollment is forced at first sign-in.
DRANZO_ADMIN_PASSWORD=CHANGE_ME_long_unique_passphrase
# Only for `--profile mesh` / remote desktop.
MESH_URL=
MESH_LOGIN_TOKEN_KEY=
